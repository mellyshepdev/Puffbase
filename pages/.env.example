# SlimeGit user dashboard (app.prime-quality.online)
# Next.js app - runs standalone on port 3500, separate realm from the
# admin console (puffbase.prime-quality.online/console).

APP_URL=https://app.prime-quality.online
KEYCLOAK_URL=https://auth.theofficialblacksheepco.com
KEYCLOAK_REALM=puffbase-customers
KEYCLOAK_CLIENT_ID=slimegit
KEYCLOAK_CLIENT_SECRET=
SESSION_SECRET=
DATABASE_URL=postgresql://root@100.99.131.20:26257/puffbase?sslmode=disable

# Token exchange: OpenBao issues per-account pufftokens for the internal
# git daemon (src/lib/pufftoken.ts) and stores user PATs (src/lib/pat.ts).
# The broker token is mounted at BAO_TOKEN_FILE - never a literal here.
BAO_ADDR=http://100.82.31.92:8200
BAO_TOKEN_FILE=/run/secrets/bao.token
